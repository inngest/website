#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
node_home="$HOME/.local/share/node-v22"
profile_marker="# inngest-website Node.js 22"

step() {
  local label="$1"
  shift
  local started=$SECONDS

  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

install_node() (
  local architecture archive checksum_file install_dir version work_dir

  case "$(uname -m)" in
    x86_64) architecture="x64" ;;
    aarch64 | arm64) architecture="arm64" ;;
    *)
      printf 'Unsupported architecture: %s\n' "$(uname -m)" >&2
      return 1
      ;;
  esac

  mkdir -p "$(dirname "$node_home")"
  work_dir="$(mktemp -d "$(dirname "$node_home")/.node-v22-install.XXXXXX")"
  trap 'rm -rf "$work_dir"' EXIT
  checksum_file="$work_dir/SHASUMS256.txt"

  curl --fail --silent --show-error --location \
    https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt \
    --output "$checksum_file"
  archive="$(awk -v architecture="$architecture" \
    '$2 ~ ("^node-v[0-9.]+-linux-" architecture "\\.tar\\.xz$") { print $2; exit }' \
    "$checksum_file")"

  if [[ -z "$archive" ]]; then
    printf 'Could not find a Node.js 22 archive for %s\n' "$architecture" >&2
    return 1
  fi

  version="${archive#node-v}"
  version="${version%-linux-*}"
  curl --fail --silent --show-error --location \
    "https://nodejs.org/dist/v${version}/${archive}" \
    --output "$work_dir/$archive"
  (cd "$work_dir" && grep "  $archive$" SHASUMS256.txt | sha256sum --check --status)

  install_dir="$work_dir/node"
  mkdir -p "$install_dir"
  tar --extract --xz --file "$work_dir/$archive" \
    --directory "$install_dir" --strip-components=1
  "$install_dir/bin/node" --version >/dev/null
  test -x "$install_dir/bin/corepack"

  rm -rf "$node_home"
  mv "$install_dir" "$node_home"
)

if [[ ! -x "$node_home/bin/node" ]] || \
  [[ "$($node_home/bin/node --version)" != v22.* ]]; then
  step "Install Node.js 22" install_node
fi

profile_file="$HOME/.profile"
for candidate in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
  if [[ -e "$candidate" ]]; then
    profile_file="$candidate"
    break
  fi
done

if ! grep -Fqx "$profile_marker" "$profile_file" 2>/dev/null; then
  cat >> "$profile_file" <<'EOF'

# inngest-website Node.js 22
export PATH="$HOME/.local/share/node-v22/bin:$PATH"
EOF
fi

export PATH="$node_home/bin:$PATH"
package_manager="$(cd "$repo_root" && \
  node --print "require('./package.json').packageManager")"

step "Activate Corepack" corepack enable --install-directory "$node_home/bin"
step "Prepare $package_manager" corepack prepare "$package_manager" --activate
step "Install workspace dependencies" \
  pnpm --dir "$repo_root" install --frozen-lockfile

printf 'Ready: Node.js %s, pnpm %s\n' "$(node --version)" "$(pnpm --version)"
